{
  "name": "nextjs-template",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "flt": "npm run format:write && npm run lint:fix && npm run typecheck",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx,json,md,css}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx,json,md,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --project tsconfig.json --pretty --noEmit && echo "
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cssnano": "^9.1.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "prettier-plugin-tailwindcss": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "latest",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
